{
  "manifest_version": 3,
  "name": "Saemi Unproductive Limit",
  "version": "0.6.0",
  "description": "Blocks YouTube/Instagram once the 2h daily allowance (phone + laptop) is used up.",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "*://samuelbaumgartner.ch/*",
    "*://www.samuelbaumgartner.ch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  }
}
