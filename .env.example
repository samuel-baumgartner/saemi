# Environment Variables Template
# Copy this file to .env.local and fill in your values

# NextAuth.js Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-key-here

# Google OAuth Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Base URL (for production)
# NEXTAUTH_URL=https://yourdomain.com

# Google Fit API (included with Google OAuth)
# No additional credentials needed - uses same Google OAuth
# Scopes are configured in src/auth.ts

# TimeChecker CLI sync (POST /api/focus/timechecker/sync)
# Generate secret: openssl rand -hex 32
TIMECHECKER_SYNC_SECRET=
# Same Google email you use to sign in at /personal
TIMECHECKER_SYNC_USER_EMAIL=

# Android home screen widget (GET /api/widget/daily-goals)
# Generate token: openssl rand -hex 32
WIDGET_API_TOKEN=
# Prisma userId for that account (same email as Google sign-in)
WIDGET_USER_ID=

# Prisma Postgres / Postgres (see prisma/schema.prisma → PRISMA_DATABASE_URL)
# Use the DIRECT connection string from the Prisma dashboard:
#   postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require
# If Accelerate hits plan limits (P6003), avoid prisma+postgres://accelerate... here.
# Set the same URL in Vercel for PRISMA_DATABASE_URL, DATABASE_URL, POSTGRES_URL.
# PRISMA_DATABASE_URL=
# DATABASE_URL=
# POSTGRES_URL=

# Calendar day for server APIs when ?date= is omitted (Vercel is UTC). Default: Asia/Tokyo
# CALENDAR_TIMEZONE=Asia/Tokyo
