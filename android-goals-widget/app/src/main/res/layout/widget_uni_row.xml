<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/uni_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <TextView
        android:id="@+id/uni_row_color"
        android:layout_width="4dp"
        android:layout_height="34dp"
        android:layout_marginEnd="10dp"
        android:background="#6366f1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/uni_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/uni_row_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/uni_row_due"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/widget_muted"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
