// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("PRISMA_DATABASE_URL") // uses Prisma Accelerate
}

model TimeSession {
  id          String   @id @default(cuid())
  userId      String   // Google account email or ID
  activity    String
  description String?
  startTime   DateTime
  endTime     DateTime?
  date        String   // YYYY-MM-DD for easy querying
  source      String   @default("tracked") // 'manual', 'tracked', 'google-fit'
  
  // Health data (stored as JSON)
  healthDataType String? // 'sleep', 'workout', 'activity'
  healthDataDetails Json? // detailed metrics
  // Web-edited phone row: kept on widget re-sync; see phone-sessions/sync.
  userOverridden Boolean @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, date]) // Index for fast queries by user and date
  @@index([userId, startTime]) // Index for time-range queries
}

model FocusSyncLog {
  id             String   @id @default(cuid())
  userId         String
  sessionCount   Int
  message        String   @default("")
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model UserGoalSettings {
  userId    String   @id
  goalsJson Json
  updatedAt DateTime @updatedAt
}
