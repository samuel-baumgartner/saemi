<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#000000">

    <TextView
        android:id="@+id/blockerMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="24dp"
        android:text="@string/unproductive_blocker_message" />

    <Button
        android:id="@+id/blockerCloseButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Go to home" />

    <Button
        android:id="@+id/blockerHoldButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/blocker_hold_idle" />

    <ProgressBar
        android:id="@+id/blockerHoldProgress"
        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="0" />

    <TextView
        android:id="@+id/blockerHoldStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp" />

</LinearLayout>
